# =============== DEVELOPMENT ENVIRONMENT ===============

# Spring Profiles Active
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
SPRING_R2DBC_URL=r2dbc:postgresql://localhost:5432/satsflow
SPRING_R2DBC_USERNAME=satsflow
SPRING_R2DBC_PASSWORD=satsflow_password
SPRING_R2DBC_POOL_MAX_ACQUIRE_TIME=2000
SPRING_R2DBC_POOL_INITIAL_SIZE=5
SPRING_R2DBC_POOL_MAX_SIZE=10

# Redis Configuration
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# JWT Configuration
APP_JWT_SECRET=dev-secret-key-not-for-production-12345678901234567890
APP_JWT_EXPIRATION=604800  # 7 days for development

# Logging
LOGGING_LEVEL_ROOT=DEBUG
LOGGING_LEVEL_BR_COM_VINISANTOSDEV=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=DEBUG

# =============== PRODUCTION ENVIRONMENT ===============
# Uncomment and change values for production deployment

# SPRING_PROFILES_ACTIVE=prod
# SPRING_R2DBC_URL=r2dbc:postgresql://prod-db.example.com:5432/satsflow
# SPRING_R2DBC_USERNAME=satsflow_prod
# SPRING_R2DBC_PASSWORD=change_me_very_strong_password_here
# SPRING_REDIS_HOST=prod-redis.example.com
# SPRING_REDIS_PORT=6379
# SPRING_REDIS_PASSWORD=redis_strong_password

# JWT - CHANGE THESE VALUES IN PRODUCTION!
# APP_JWT_SECRET=use_a_very_long_and_random_secret_key_here_minimum_32_chars
# APP_JWT_EXPIRATION=86400  # 24 hours for production

# LOGGING
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_BR_COM_VINISANTOSDEV=INFO

# =============== OPTIONAL: BITCOIN SETTINGS ===============
# For future Lightning Network integration

# BITCOIN_NETWORK=testnet  # mainnet or testnet
# LN_NODE_URL=https://your-lightning-node.com
# LN_API_KEY=your_ln_api_key
# BITCOIN_RPC_URL=http://bitcoin-node:18332
# BITCOIN_RPC_USER=bitcoinrpc
# BITCOIN_RPC_PASSWORD=change_me

# =============== OPTIONAL: MONITORING ===============

# PROMETHEUS_ENABLED=true
# PROMETHEUS_PORT=9090
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

